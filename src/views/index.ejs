<%- include('partials/header') %>

    <section class="earth-section">
        <div class="earth-content">
            <h2>Velkominn á My little pony vefsíðuna</h2>
            <p>Hérna getur þú fundið upplýsingar um My little pony og allskonar hluti.</p>
            <a href="/hlutir" class="btn-primary">Skoða allskynshlutir</a>
        </div>
    </section>

    <section class="featured">
        <h3>Einhvað</h3>
        <div class="card-grid">
            <% if (characters && characters.length > 0) { %>
                <% characters.forEach(character => { %>
                    <div class="pegasus-card">
                        
                        <img class="card-img"
                            src="/images/<%= character.image %>"
                            alt="<%= character.description %>">
                        
                        
                        <div class="card-info">
                            <h4><%= character.name %></h4>
                            <p><%= character.description %></p>

                            <a href="/hlutir/<%= character.id %>" style="color: #ff6b6b; font-weight: 600; text-decoration: none; 
                            display: inline-block; margin-top: 15px;">
                            </a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="pegasus-card">
                    <div class="card-info">
                        <h4>Funny things</h4>
                        <p>Something that is funny, but not funny.</p>
                    </div>
                </div>
            <% } %>
        </div>
    </section>

<%- include('partials/footer') %>